{
  "name": "winapi-atlas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive Windows API catalog mapped to malware techniques, telemetry, and detection guidance.",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-seo.mjs",
    "build:seo": "node scripts/build-seo.mjs",
    "preview:seo": "npm run build:seo && node scripts/serve.mjs 8001 --dist",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/",
    "check:seo": "npm run build:seo && node scripts/check-seo.mjs",
    "check": "npm run validate && npm test && npm run check:seo"
  },
  "engines": {
    "node": ">=20"
  }
}
